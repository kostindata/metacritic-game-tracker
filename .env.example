# Copy to .env and fill in. Everything except the API key has a sensible default.

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash
# Language the AI summaries are written in
SUMMARY_LANGUAGE=Russian
# Completion token budget, including the model's hidden reasoning
LLM_MAX_TOKENS=8000
# Model "thinking" before answering: false is ~3x faster with similar summary quality
LLM_REASONING=false

# --- Crawl ---
# Games processed per crawl run (first run of the day: New Releases, then the browse listing)
GAMES_PER_RUN=500
NEW_RELEASES_COUNT=20
# Games fetched in parallel; total traffic stays at 1 request/second (REQUEST_INTERVAL_SECONDS)
CRAWL_CONCURRENCY=4
MAX_LISTING_PAGES_PER_RUN=100
MAX_REVIEWS_PER_TYPE=30
MIN_REVIEWS_FOR_SUMMARY=3
# Hourly crawl at HH:<minute> local time (TIMEZONE)
CRAWL_SCHEDULE_MINUTE=0
# Timezone for the crawl day, schedules and displayed times (Europe/Moscow = UTC+3, no DST)
TIMEZONE=Europe/Moscow
# Local hour at which "today" rolls over: processed set cleared, cursor reset
DAILY_RESET_HOUR=0
# Crawl lock TTL; refreshed before every request, so a killed worker frees it this fast
LOCK_TTL_SECONDS=120

# --- Politeness ---
REQUEST_INTERVAL_SECONDS=1.0
HTTP_MAX_ATTEMPTS=4
HTTP_BACKOFF_BASE_SECONDS=2.0
USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36
PLAYWRIGHT_ENABLED=true

# --- Logging ---
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json

# --- Ports ---
WEB_PORT=8000

# DATABASE_URL / REDIS_URL are set by docker-compose. For running outside Docker:
# DATABASE_URL=postgresql+psycopg://mc:mc@localhost:5432/mc
# REDIS_URL=redis://localhost:6379/0
